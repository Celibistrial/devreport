# Copy to .env and fill in. .env is gitignored; real environment variables override it.

# Engine: cli = Claude Code headless (needs a Claude Code login); ai = our own agent loop on the Vercel AI SDK
DEVREPORT_ENGINE=cli

# Model for the ai engine, as provider:model. Examples:
#   claude-code:opus                         (your Claude Code login, no key)
#   openrouter:deepseek/deepseek-v4.1-flash  (OPENROUTER_API_KEY)
#   openai:gpt-5                             (OPENAI_API_KEY)
#   anthropic:claude-sonnet-5-5              (ANTHROPIC_API_KEY)
#   google:gemini-2.5-pro                    (GOOGLE_GENERATIVE_AI_API_KEY)
#   openai-compatible:<model>                (DEVREPORT_BASE_URL, DEVREPORT_API_KEY)
DEVREPORT_MODEL=claude-code:opus

# Only the key for the provider you use
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# For openai-compatible servers (Groq, Together, DeepSeek, LM Studio, Ollama...)
# DEVREPORT_BASE_URL=
# DEVREPORT_API_KEY=

# Optional
# PORT=3000
# DEVREPORT_TIMEOUT_MIN=10
# DEVREPORT_REASONING_EFFORT=none
