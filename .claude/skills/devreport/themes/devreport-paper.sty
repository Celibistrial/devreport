% devreport-paper: serif, cream, academic. Works with article and beamer (XeTeX/tectonic).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{devreport-paper}[2026/10/02 devreport Paper theme]

\RequirePackage{amssymb}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{pgfplots}
\usepgfplotslibrary{dateplot}
\pgfplotsset{compat=1.18}
\RequirePackage{pgf-pie}
\RequirePackage{booktabs}
\RequirePackage{graphicx}

% ---- palette (shared names across all devreport themes) ----
\definecolor{drBg}{HTML}{F8F4EA}
\definecolor{drInk}{HTML}{2A2420}
\definecolor{drMuted}{HTML}{7A6F63}
\definecolor{drGrid}{HTML}{E4DCCB}
\definecolor{drAccent}{HTML}{9B2F1F}   % oxblood
\definecolor{drAccentB}{HTML}{2F5D62}  % deep teal
\definecolor{drAccentC}{HTML}{C08A2E}  % ochre
\definecolor{drAccentD}{HTML}{5B4B8A}  % plum
\definecolor{drAccentE}{HTML}{6E8B3D}  % olive
\definecolor{drPanel}{HTML}{EFE8D8}

% ---- fonts (all ship in the tectonic bundle) ----
\setmainfont{texgyrepagella}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic,Numbers=OldStyle]
\newfontfamily\drNumFont{texgyrepagella}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,Numbers=Lining]
\setsansfont{FiraSans}[Extension=.otf,UprightFont=*-Light,BoldFont=*-Medium,ItalicFont=*-LightItalic,BoldItalicFont=*-MediumItalic,Scale=0.92]
\setmonofont{FiraMono}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,Scale=0.86]

% ---- type scale: every text size comes from these names; main.tex uses them and never \small, \Large, \fontsize ----
\makeatletter
\@ifclassloaded{beamer}{%
  \newcommand{\drTitle}{\fontsize{30}{32}\selectfont}% title on the title page
  \newcommand{\drH}{\Large}%                     frame titles
  \newcommand{\drSub}{\normalsize}%              frame subtitles, block titles
  \newcommand{\drCaption}{\scriptsize}%          captions, footline, stat-tile labels, numbers on bars
}{%
  \newcommand{\drTitle}{\fontsize{34}{38}\selectfont}% title on the first page
  \newcommand{\drH}{\Large}%                     sections
  \newcommand{\drSub}{\small}%                   subsections
  \newcommand{\drCaption}{\small}%               figure captions, stat-tile labels
}
\makeatother
\newcommand{\drLead}{\large}%                    the subtitle line under the title
\newcommand{\drBody}{\normalsize}%               body text, bullets at every level
\newcommand{\drSmall}{\footnotesize}%            chart text, header/footer lines
\newcommand{\drStat}{\fontsize{22}{24}\selectfont}% big stat-tile numbers

% ---- charts ----
\pgfplotscreateplotcyclelist{devreport}{%
  {drAccent,mark=*,mark options={fill=drAccent}},
  {drAccentB,mark=square*,mark options={fill=drAccentB}},
  {drAccentC,mark=triangle*,mark options={fill=drAccentC}},
  {drAccentD,mark=diamond*,mark options={fill=drAccentD}}}
\pgfplotscreateplotcyclelist{devreportbar}{{drAccent,fill=drAccent},{drAccentB,fill=drAccentB},{drAccentC,fill=drAccentC},{drAccentD,fill=drAccentD}}
\pgfplotsset{
  every axis/.append style={
    font=\sffamily\drSmall, cycle list name=devreport,
    axis line style={drMuted, line width=0.4pt}, tick style={drMuted},
    axis x line*=bottom, axis y line*=left,
    ymajorgrids, grid style={drGrid, line width=0.4pt},
    every axis label/.append style={drMuted},
    tick label style={drInk}, every node near coord/.append style={font=\drCaption, drMuted}, title style={font=\rmfamily\itshape\drSmall, drInk},
    legend style={draw=none, fill=none, font=\sffamily\drCaption},
    width=0.92\linewidth, height=0.42\linewidth, scaled y ticks=false,
    enlarge x limits=0.04,
  },
  every axis plot/.append style={line width=1.1pt, mark size=1.6pt},
  drbar/.style={ybar, cycle list name=devreportbar, bar width=12pt, every axis plot/.append style={fill opacity=0.9, draw=none}},
  drstrip/.style={height=3cm, width=\linewidth, ytick=\empty, ymajorgrids=false},
  drhbar/.style={xbar, cycle list name=devreportbar, scale only axis, width=0.6\linewidth, bar width=9pt, xmajorgrids, ymajorgrids=false, axis y line*=none, ytick style={draw=none}, enlarge x limits={upper,value=0.1}, yticklabel style={font=\ttfamily\drCaption}, every axis plot/.append style={draw=none}},
}
\newcommand{\drPieColors}{drAccent,drAccentB,drAccentC,drAccentD,drAccentE,drMuted,drGrid}
\RequirePackage{pgfplotstable}
% \drsafecats: make _ # & $ ^ % ~ printable before reading CSV labels (use inside a group)
\newcommand{\drsafecats}{\catcode`\_=12 \catcode`\#=12 \catcode`\&=12 \catcode`\$=12 \catcode`\^=12 \catcode`\%=12 \catcode`\~=12 }
% \drpie[pgf-pie options]{csv}{label column}{value column}: pie read from a CSV, no typed numbers
\newcommand{\drpie}[4][]{\begingroup\drsafecats
  \pgfplotstableread[col sep=comma]{#2}\drPieTable
  \pgfplotstablegetrowsof{\drPieTable}\pgfmathtruncatemacro\drN{\pgfplotsretval-1}%
  \gdef\drPieList{}%
  \foreach \i in {0,...,\drN}{%
    \pgfplotstablegetelem{\i}{#4}\of\drPieTable\let\drV\pgfplotsretval
    \pgfplotstablegetelem{\i}{#3}\of\drPieTable\let\drL\pgfplotsretval
    \ifx\drPieList\empty\xdef\drPieList{\drV/\unexpanded\expandafter{\drL}}%
    \else\xdef\drPieList{\unexpanded\expandafter{\drPieList},\drV/\unexpanded\expandafter{\drL}}\fi}%
  \begin{tikzpicture}\edef\x{\noexpand\pie[sum=auto,text=legend,radius=2.1,color={\drPieColors},#1]{\unexpanded\expandafter{\drPieList}}}\x\end{tikzpicture}\endgroup}

% ---- KPI tile: \drkpi{1,204}{commits} ----
\newcommand{\drkpi}[2]{%
  \begin{minipage}[t]{0.23\linewidth}\centering
  {\drNumFont\drStat\color{drAccent}#1}\\[2pt]
  {\sffamily\drCaption\color{drMuted}\MakeUppercase{#2}}\end{minipage}}

\makeatletter
\@ifclassloaded{beamer}{%
  % ================= BEAMER =================
  \usefonttheme{serif}
  \setbeamertemplate{navigation symbols}{}
  \setbeamercolor{background canvas}{bg=drBg}
  \setbeamercolor{normal text}{fg=drInk}
  \setbeamercolor{structure}{fg=drAccent}
  \setbeamercolor{frametitle}{fg=drInk}
  \setbeamercolor{title}{fg=drInk}
  \setbeamercolor{subtitle}{fg=drAccent}
  \setbeamercolor{alerted text}{fg=drAccent}
  \setbeamercolor{block title}{fg=drAccent,bg=drPanel}
  \setbeamercolor{block body}{fg=drInk,bg=drPanel}
  \setbeamercolor{caption name}{fg=drAccent}
  \setbeamerfont{caption}{size=\drCaption}
  \setbeamerfont{block title}{size=\drSub}
  \setbeamerfont{framesubtitle}{size=\drSub}
  \setbeamerfont{footline}{size=\drCaption}
  \setbeamerfont{itemize/enumerate body}{size=\drBody}
  \setbeamerfont{itemize/enumerate subbody}{size=\drBody}
  \setbeamerfont{itemize/enumerate subsubbody}{size=\drBody}
  \setbeamertemplate{caption}[numbered]
  \setbeamertemplate{itemize item}{\color{drAccent}\raisebox{0.15ex}{\scriptsize$\blacksquare$}}
  \setbeamertemplate{itemize subitem}{\color{drAccentB}\textendash}
  \setbeamertemplate{enumerate item}{\color{drAccent}\drNumFont\insertenumlabel.}
  \setbeamerfont{frametitle}{size=\drH,shape=\itshape}
  \setbeamertemplate{frametitle}{%
    \vskip1.2em\hskip0.2em{\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\par
    \hskip0.2em{\color{drAccent}\rule{2.2em}{1.2pt}}\vskip0.2em}
  \setbeamertemplate{footline}{%
    \leavevmode\hbox to \paperwidth{\hskip1.2em{\sffamily\drCaption\color{drMuted}\MakeUppercase{\insertshorttitle}}\hfill
    {\drNumFont\drCaption\color{drAccent}\insertframenumber}\hskip1.2em}\vskip0.9em}
  \setbeamertemplate{title page}{%
    \vspace*{\fill}% frames are top-aligned (devreport-layout), so a plain \vfill here would be dropped
    {\sffamily\drCaption\color{drAccent}\MakeUppercase{Project report}}\par\vskip0.6em
    {\usebeamerfont{title}\drTitle\itshape\color{drInk}\inserttitle}\par\vskip0.4em
    {\color{drAccent}\rule{3em}{1.5pt}}\par\vskip0.8em
    \ifx\insertsubtitle\@empty\else{\drLead\color{drMuted}\insertsubtitle}\par\vskip0.8em\fi
    {\sffamily\drSmall\color{drInk}\insertauthor}\par
    {\sffamily\drSmall\color{drMuted}\insertdate}\par
    }% beamer adds the bottom \vfill of a top-aligned frame, so this centres the block
  \RequirePackage{../../.claude/skills/devreport/themes/devreport-layout}% frame layout macros, chart size
  \renewcommand{\drChartH}{0.68\textheight}% the frame title sits in the text area here
}{%
  % ================= ARTICLE =================
  \RequirePackage[a4paper,margin=2.6cm,top=2.4cm,bottom=2.8cm]{geometry}
  \RequirePackage{pagecolor}
  \pagecolor{drBg}\color{drInk}
  \RequirePackage{caption}\DeclareCaptionFont{drcap}{\drCaption}
  \captionsetup{font={drcap,it},labelfont={sf,bf,color=drAccent,up},labelsep=quad,skip=6pt}
  \RequirePackage{titlesec}
  \RequirePackage{needspace}% a section heading never sits alone at the foot of a page
  \titleformat{\section}{\needspace{5\baselineskip}\drH\itshape\color{drInk}}{\llap{\drNumFont\color{drAccent}\upshape\thesection\hskip0.8em}}{0pt}{}[\vskip-0.4em{\color{drGrid}\rule{\linewidth}{0.5pt}}]
  \titleformat{\subsection}{\sffamily\drSub\bfseries\color{drAccentB}}{\thesubsection}{0.8em}{\MakeUppercase}
  \titlespacing*{\section}{0pt}{1.8em}{0.9em}
  \titlespacing*{\subsection}{0pt}{1.4em}{0.4em}
  \RequirePackage{enumitem}
  \setlist[itemize]{label={\color{drAccent}\raisebox{0.2ex}{\tiny$\blacksquare$}},leftmargin=1.4em,itemsep=2pt}
  \setlist[enumerate]{label={\color{drAccent}\drNumFont\arabic*.},leftmargin=1.6em,itemsep=2pt}
  \RequirePackage{fancyhdr}
  \pagestyle{fancy}\fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyhead[L]{\sffamily\drSmall\color{drMuted}\MakeUppercase{\@title}}
  \fancyhead[R]{\sffamily\drSmall\color{drMuted}\@date}
  \fancyfoot[C]{\drNumFont\drSmall\color{drAccent}\thepage}
  \fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\drNumFont\drSmall\color{drAccent}\thepage}}
  \linespread{1.08}
  \setlength{\parskip}{0.35em}
  \providecommand{\subtitle}[1]{\gdef\@subtitle{#1}}
  \gdef\@subtitle{}
  \renewcommand{\maketitle}{%
    \thispagestyle{plain}\begingroup\setlength{\parindent}{0pt}
    \vspace*{0.5em}
    {\sffamily\drCaption\color{drAccent}\MakeUppercase{Project report}}\par\vskip0.8em
    {\drTitle\itshape\color{drInk}\@title\par}\vskip0.6em
    {\color{drAccent}\rule{3.5em}{1.6pt}}\par\vskip0.8em
    \ifx\@subtitle\@empty\else{\drLead\color{drMuted}\@subtitle\par}\vskip0.6em\fi
    {\sffamily\drSmall\color{drInk}\@author}\hfill{\sffamily\drSmall\color{drMuted}\@date}\par
    \vskip0.4em{\color{drGrid}\rule{\linewidth}{0.5pt}}\par\endgroup\vskip1.2em}
  % floats: let figures share pages with text, and stack float-only pages from the top instead of spreading them out
  \renewcommand{\topfraction}{0.85}\renewcommand{\bottomfraction}{0.6}\renewcommand{\textfraction}{0.12}\renewcommand{\floatpagefraction}{0.75}
  \setlength{\@fptop}{0pt}\setlength{\@fpsep}{1.6em}\setlength{\@fpbot}{0pt plus 1fil}
  \setlength{\textfloatsep}{1.4em plus 0.4em minus 0.4em}\setlength{\intextsep}{1.2em plus 0.4em minus 0.4em}
  \RequirePackage{hyperref}
  \hypersetup{colorlinks,linkcolor=drAccent,urlcolor=drAccentB,citecolor=drAccent,pdfborder={0 0 0}}
}
\makeatother
\endinput
