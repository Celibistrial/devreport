% devreport-midnight: dark, neon accent, terminal/dev look. Works with article and beamer (XeTeX/tectonic).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{devreport-midnight}[2026/10/02 devreport Midnight theme]

\RequirePackage{amssymb}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{pgfplots}
\usepgfplotslibrary{dateplot}
\pgfplotsset{compat=1.18}
\RequirePackage{pgf-pie}
\RequirePackage{booktabs}
\RequirePackage{graphicx}

% ---- palette (shared names across all devreport themes) ----
\definecolor{drBg}{HTML}{0B0F17}
\definecolor{drPanel}{HTML}{141B26}
\definecolor{drInk}{HTML}{D7DEE8}
\definecolor{drMuted}{HTML}{6B7A90}
\definecolor{drGrid}{HTML}{1F2937}
\definecolor{drAccent}{HTML}{3DF5A7}   % neon mint
\definecolor{drAccentB}{HTML}{4CC9F0}  % cyan
\definecolor{drAccentC}{HTML}{F72585}  % magenta
\definecolor{drAccentD}{HTML}{FFD166}  % amber
\definecolor{drAccentE}{HTML}{9B5DE5}  % violet

% ---- fonts (all ship in the tectonic bundle) ----
\setsansfont{FiraSans}[Extension=.otf,UprightFont=*-Light,BoldFont=*-SemiBold,ItalicFont=*-LightItalic,BoldItalicFont=*-SemiBoldItalic]
\setmainfont{FiraSans}[Extension=.otf,UprightFont=*-Light,BoldFont=*-SemiBold,ItalicFont=*-LightItalic,BoldItalicFont=*-SemiBoldItalic]
\setmonofont{FiraMono}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]
\newfontfamily\drNumFont{FiraMono}[Extension=.otf,UprightFont=*-Medium,BoldFont=*-Bold]
\newcommand{\drPrompt}{{\color{drAccent}\ttfamily\$\,}}

% ---- type scale: every text size comes from these names; main.tex uses them and never \small, \Large, \fontsize ----
\makeatletter
\@ifclassloaded{beamer}{%
  \newcommand{\drTitle}{\fontsize{28}{32}\selectfont}% title on the title page
  % sized for a 160 x 90 mm slide, the same scale as devreport-core
  \newcommand{\drH}{\fontsize{18}{22}\selectfont}%        frame titles
  \newcommand{\drSub}{\fontsize{15}{19}\selectfont}%      frame subtitles, block titles, callouts
  \newcommand{\drBody}{\fontsize{13.5}{16.2}\selectfont}%     body text, bullets at every level, tables
  \newcommand{\drSmall}{\fontsize{11.5}{14}\selectfont}%  chart text, flow captions, footer lines
  \newcommand{\drCaption}{\fontsize{10}{12}\selectfont}%  captions, footline, stat-tile labels, numbers on bars
  \newcommand{\drStat}{\fontsize{28}{30}\selectfont}%     big stat-tile numbers
  \newcommand{\drHero}{\fontsize{84}{84}\selectfont}%     the number in \drBigNumber
}{%
  \newcommand{\drTitle}{\fontsize{32}{36}\selectfont}% title on the first page
  \newcommand{\drH}{\Large}%                     sections
  \newcommand{\drSub}{\small}%                   subsections
  \newcommand{\drCaption}{\small}%               figure captions, stat-tile labels
  \newcommand{\drBody}{\normalsize}%             body text, bullets at every level
  \newcommand{\drSmall}{\footnotesize}%          chart text, header/footer lines
  \newcommand{\drStat}{\fontsize{22}{24}\selectfont}% big stat-tile numbers
}
\makeatother
\newcommand{\drLead}{\large}%                    the subtitle line under the title

% ---- charts ----
\pgfplotscreateplotcyclelist{devreport}{%
  {drAccent,mark=*,mark options={fill=drAccent}},
  {drAccentB,mark=square*,mark options={fill=drAccentB}},
  {drAccentC,mark=triangle*,mark options={fill=drAccentC}},
  {drAccentD,mark=diamond*,mark options={fill=drAccentD}}}
\pgfplotscreateplotcyclelist{devreportbar}{{drAccent,fill=drAccent},{drAccentB,fill=drAccentB},{drAccentC,fill=drAccentC},{drAccentD,fill=drAccentD}}
\pgfplotsset{
  every axis/.append style={
    font=\ttfamily\drSmall, cycle list name=devreport,
    axis line style={drMuted, line width=0.4pt}, tick style={drMuted},
    axis x line*=bottom, axis y line*=left,
    ymajorgrids, grid style={drGrid, line width=0.5pt, dashed},
    every axis label/.append style={drMuted},
    tick label style={drInk}, every node near coord/.append style={font=\drCaption, drMuted}, title style={font=\ttfamily\drSmall, drAccent},
    legend style={draw=none, fill=none, text=drInk, font=\ttfamily\drCaption},
    width=0.92\linewidth, height=0.42\linewidth, scaled y ticks=false,
    enlarge x limits=0.04,
  },
  every axis plot/.append style={line width=1.3pt, mark size=1.6pt},
  drbar/.style={ybar, cycle list name=devreportbar, bar width=12pt, every axis plot/.append style={fill opacity=0.85, draw=none}},
  drstrip/.style={height=3cm, width=\linewidth, ytick=\empty, ymajorgrids=false},
  drhbar/.style={xbar, cycle list name=devreportbar, scale only axis, width=0.6\linewidth, bar width=9pt, xmajorgrids, ymajorgrids=false, axis y line*=none, ytick style={draw=none}, enlarge x limits={upper,value=0.1}, yticklabel style={font=\ttfamily\drCaption}, every axis plot/.append style={draw=none}},
}
\newcommand{\drPieColors}{drAccent,drAccentB,drAccentC,drAccentD,drAccentE,drInk,drMuted}
\RequirePackage{pgfplotstable}
% \drsafecats: make _ # & $ ^ % ~ printable before reading CSV labels (use inside a group)
\newcommand{\drsafecats}{\catcode`\_=12 \catcode`\#=12 \catcode`\&=12 \catcode`\$=12 \catcode`\^=12 \catcode`\%=12 \catcode`\~=12 }
% \drpie[pgf-pie options]{csv}{label column}{value column}: pie read from a CSV, no typed numbers
\newcommand{\drpie}[4][]{\begingroup\drsafecats
  \pgfplotstableread[col sep=comma]{#2}\drPieTable
  \pgfplotstablegetrowsof{\drPieTable}\pgfmathtruncatemacro\drN{\pgfplotsretval-1}%
  \gdef\drPieList{}%
  \foreach \i in {0,...,\drN}{%
    \pgfplotstablegetelem{\i}{#4}\of\drPieTable\let\drV\pgfplotsretval
    \pgfplotstablegetelem{\i}{#3}\of\drPieTable\let\drL\pgfplotsretval
    \ifx\drPieList\empty\xdef\drPieList{\drV/\unexpanded\expandafter{\drL}}%
    \else\xdef\drPieList{\unexpanded\expandafter{\drPieList},\drV/\unexpanded\expandafter{\drL}}\fi}%
  \begin{tikzpicture}\edef\x{\noexpand\pie[sum=auto,text=legend,radius=2.1,color={\drPieColors},before number={\noexpand\color{drBg}\noexpand\bfseries},#1]{\unexpanded\expandafter{\drPieList}}}\x\end{tikzpicture}\endgroup}

% ---- KPI tile: \drkpi{1,204}{commits} ----
\newcommand{\drkpi}[2]{%
  \begin{minipage}[t]{0.23\linewidth}\centering
  {\drNumFont\drStat\color{drAccent}#1}\\[3pt]
  {\ttfamily\drCaption\color{drMuted}// #2}\end{minipage}}

\makeatletter
\@ifclassloaded{beamer}{%
  % ================= BEAMER =================
  \usefonttheme{professionalfonts}
  \setbeamertemplate{navigation symbols}{}
  \setbeamercolor{background canvas}{bg=drBg}
  \setbeamercolor{normal text}{fg=drInk}
  \setbeamercolor{structure}{fg=drAccent}
  \setbeamercolor{frametitle}{fg=drInk}
  \setbeamercolor{title}{fg=drInk}
  \setbeamercolor{subtitle}{fg=drAccentB}
  \setbeamercolor{alerted text}{fg=drAccentC}
  \setbeamercolor{block title}{fg=drAccent,bg=drPanel}
  \setbeamercolor{block body}{fg=drInk,bg=drPanel}
  \setbeamercolor{caption name}{fg=drAccent}
  \setbeamerfont{caption}{size=\drCaption}
  \setbeamerfont{block title}{size=\drSub}
  \setbeamerfont{framesubtitle}{size=\drSub}
  \setbeamerfont{footline}{size=\drCaption}
  \setbeamerfont{itemize/enumerate body}{size=\drBody}
  \setbeamerfont{itemize/enumerate subbody}{size=\drBody}
  \setbeamerfont{itemize/enumerate subsubbody}{size=\drBody}
  \setbeamertemplate{caption}[numbered]
  \setbeamertemplate{itemize item}{\color{drAccent}\ttfamily>}
  \setbeamertemplate{itemize subitem}{\color{drAccentB}\ttfamily-}
  \setbeamertemplate{enumerate item}{\color{drAccent}\ttfamily\insertenumlabel.}
  \setbeamerfont{frametitle}{size=\drH,series=\bfseries}
  \setbeamertemplate{frametitle}{%
    \vskip0.4em\hskip0.2em{\ttfamily\drCaption\color{drMuted}\insertframenumber\ /\ \inserttotalframenumber}\par\vskip0.1em
    \hskip0.2em{\usebeamerfont{frametitle}\color{drAccent}\ttfamily\$\ }{\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\par\vskip-0.1em}
  \setbeamertemplate{footline}{%
    \leavevmode\hbox to \paperwidth{\hskip1.2em{\ttfamily\drCaption\color{drMuted}~/\insertshorttitle}\hfill
    {\ttfamily\drCaption\color{drMuted}\insertdate}\hskip1.2em}\vskip0.9em}
  \setbeamertemplate{title page}{%
    \vspace*{\fill}% frames are top-aligned (devreport-layout), so a plain \vfill here would be dropped
    {\ttfamily\drSmall\color{drAccent}\$ devreport --render}\par\vskip0.8em
    {\drTitle\bfseries\color{drInk}\inserttitle}{\color{drAccent}\drTitle\ttfamily\_}\par\vskip0.6em
    \ifx\insertsubtitle\@empty\else{\drLead\color{drAccentB}\insertsubtitle}\par\vskip0.8em\fi
    \ifx\beamer@shortauthor\@empty\else\ifx\beamer@shortauthor\undefined\else{\ttfamily\drSmall\color{drMuted}// \insertauthor}\par\fi\fi
    {\ttfamily\drSmall\color{drMuted}// \insertdate}\par
    }% beamer adds the bottom \vfill of a top-aligned frame, so this centres the block
  \RequirePackage{../../.claude/skills/devreport/themes/devreport-layout}% frame layout macros, chart size
  \renewcommand{\drBodyH}{0.62\paperheight}% the frame title sits in the text area here
}{%
  % ================= ARTICLE =================
  \RequirePackage[a4paper,margin=2.4cm,top=2.4cm,bottom=2.6cm]{geometry}
  \RequirePackage{pagecolor}
  \pagecolor{drBg}\color{drInk}
  \RequirePackage{caption}\DeclareCaptionFont{drcap}{\drCaption}
  \captionsetup{font={drcap,color=drMuted},labelfont={tt,bf,color=drAccent},labelsep=quad,skip=6pt}
  \RequirePackage{titlesec}
  \RequirePackage{needspace}% a section heading never sits alone at the foot of a page
  \titleformat{\section}{\needspace{5\baselineskip}\drH\bfseries\color{drInk}}{\ttfamily\color{drAccent}\thesection\ //}{0.6em}{}
  \titleformat{\subsection}{\ttfamily\drSub\color{drAccentB}}{\thesubsection}{0.8em}{}
  \titlespacing*{\section}{0pt}{1.8em}{0.8em}
  \titlespacing*{\subsection}{0pt}{1.4em}{0.4em}
  \RequirePackage{enumitem}
  \setlist[itemize]{label={\color{drAccent}\ttfamily>},leftmargin=1.4em,itemsep=2pt}
  \setlist[enumerate]{label={\color{drAccent}\ttfamily\arabic*.},leftmargin=1.6em,itemsep=2pt}
  \RequirePackage{fancyhdr}
  \pagestyle{fancy}\fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyhead[L]{\ttfamily\drSmall\color{drMuted}~/\@title}
  \fancyhead[R]{\ttfamily\drSmall\color{drMuted}\@date}
  \fancyfoot[R]{\ttfamily\drSmall\color{drAccent}[\thepage]}
  \fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\ttfamily\drSmall\color{drAccent}[\thepage]}}
  \linespread{1.1}
  \setlength{\parskip}{0.4em}
  \providecommand{\subtitle}[1]{\gdef\@subtitle{#1}}
  \gdef\@subtitle{}
  \renewcommand{\maketitle}{%
    \thispagestyle{plain}\begingroup\setlength{\parindent}{0pt}
    \vspace*{0.5em}
    {\ttfamily\drSmall\color{drAccent}\$ devreport --render report}\par\vskip1em
    {\drTitle\bfseries\color{drInk}\@title{\color{drAccent}\ttfamily\_}\par}\vskip0.8em
    \ifx\@subtitle\@empty\else{\drLead\color{drAccentB}\@subtitle\par}\vskip0.6em\fi
    {\ttfamily\drSmall\color{drMuted}// \@author\hfill\@date}\par
    \vskip0.6em{\color{drAccent}\rule{\linewidth}{0.6pt}}\par\endgroup\vskip1.2em}
  % floats: let figures share pages with text, and stack float-only pages from the top instead of spreading them out
  \renewcommand{\topfraction}{0.85}\renewcommand{\bottomfraction}{0.6}\renewcommand{\textfraction}{0.12}\renewcommand{\floatpagefraction}{0.75}
  \setlength{\@fptop}{0pt}\setlength{\@fpsep}{1.6em}\setlength{\@fpbot}{0pt plus 1fil}
  \setlength{\textfloatsep}{1.4em plus 0.4em minus 0.4em}\setlength{\intextsep}{1.2em plus 0.4em minus 0.4em}
  \RequirePackage{hyperref}
  \hypersetup{colorlinks,linkcolor=drAccent,urlcolor=drAccentB,citecolor=drAccent,pdfborder={0 0 0}}
}
\makeatother
\endinput
