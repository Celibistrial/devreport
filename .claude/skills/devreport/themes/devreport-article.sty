% devreport-article: the one look every report gets. A plain research paper: article class, 11pt Latin Modern,
% 1in margins, \maketitle + abstract, numbered sections, booktabs, numbered captions, black-and-white charts.
% It provides the same dr* names as the slide themes so the shared chart snippets compile unchanged.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{devreport-article}[2026/10/02 devreport standard article]

\RequirePackage{fontspec}% XeTeX/tectonic: Latin Modern is fontspec's default
\RequirePackage{amsmath,amssymb}
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage{pgfplots}
\usepgfplotslibrary{dateplot}
\pgfplotsset{compat=1.18}
\RequirePackage{pgfplotstable}

% ---- palette: black and greys (the names the slide themes share) ----
\definecolor{drBg}{gray}{1}
\definecolor{drPanel}{gray}{0.95}
\definecolor{drInk}{gray}{0}
\definecolor{drMuted}{gray}{0.35}
\definecolor{drGrid}{gray}{0.85}
\definecolor{drAccent}{gray}{0}
\definecolor{drAccentB}{gray}{0.45}
\definecolor{drAccentC}{gray}{0.6}
\definecolor{drAccentD}{gray}{0.3}
\definecolor{drAccentE}{gray}{0.75}

% ---- type names: the standard article sizes ----
\newcommand{\drTitle}{\LARGE}
\newcommand{\drLead}{\large}
\newcommand{\drH}{\Large}
\newcommand{\drSub}{\large}
\newcommand{\drBody}{\normalsize}
\newcommand{\drSmall}{\small}
\newcommand{\drCaption}{\small}
\newcommand{\drStat}{\normalsize}

% papers have no subtitle; accepted (and dropped) so an older main.tex still compiles
\providecommand{\subtitle}[1]{}
% article's title block, minus the gaps an empty \author{} or \date{} would leave
\makeatletter
\def\@maketitle{\newpage\null\vskip 2em\begin{center}\let\footnote\thanks
  {\LARGE\@title\par}%
  \ifx\@author\@empty\else\vskip 1.5em{\large\lineskip .5em\begin{tabular}[t]{c}\@author\end{tabular}\par}\fi
  \ifx\@date\@empty\else\vskip 1em{\large\@date}\fi
  \end{center}\par\vskip 1.5em}
\makeatother

% ---- charts: classic paper plots, boxed axes, black/grey lines with marks, labels at caption size ----
\pgfplotscreateplotcyclelist{devreport}{%
  {black,mark=*,mark options={solid,fill=black}},
  {black,dashed,mark=square*,mark options={solid,fill=white}},
  {black!55,mark=triangle*,mark options={solid,fill=black!55}},
  {black!55,densely dotted,mark=diamond*,mark options={solid,fill=white}}}
\pgfplotscreateplotcyclelist{devreportbar}{{draw=black,fill=black!30},{draw=black,fill=black!65},{draw=black,fill=white},{draw=black,fill=black!10}}
\pgfplotsset{
  every axis/.append style={
    font=\drCaption, cycle list name=devreport,
    width=0.8\linewidth, height=0.45\linewidth, scaled y ticks=false,
    tick align=inside, legend style={font=\drCaption, draw=black, fill=white},
    every node near coord/.append style={font=\drCaption},
  },
  every axis plot/.append style={line width=0.8pt, mark size=1.5pt},
  drbar/.style={ybar, cycle list name=devreportbar, bar width=14pt},
  drstrip/.style={height=3cm, width=\linewidth, ytick=\empty},
  drhbar/.style={xbar, cycle list name=devreportbar, scale only axis, width=0.55\linewidth, bar width=8pt, ytick style={draw=none}, enlarge x limits={upper,value=0.12}, yticklabel style={font=\ttfamily\drCaption}},
}
% \drsafecats: make _ # & $ ^ % ~ printable before reading CSV labels (use inside a group)
\newcommand{\drsafecats}{\catcode`\_=12 \catcode`\#=12 \catcode`\&=12 \catcode`\$=12 \catcode`\^=12 \catcode`\%=12 \catcode`\~=12 }
% \drpie[ignored]{csv}{label column}{value column}: papers don't use pies, so this draws the same CSV as a bar chart
\newcommand{\drpie}[4][]{\begingroup\drsafecats
  \begin{tikzpicture}\begin{axis}[drbar, xtick=data, xticklabels from table={#2}{#3}, table/col sep=comma, ymin=0, enlarge x limits=0.12, nodes near coords]
  \addplot table[col sep=comma, x expr=\coordindex, y=#4]{#2};
  \end{axis}\end{tikzpicture}\endgroup}
% \drkpi{value}{label}: stat tiles aren't paper-like; in a report it is plain text, "label: value"
\newcommand{\drkpi}[2]{\mbox{#2: #1}}

% floats share pages with text instead of leaving half-empty pages
\renewcommand{\topfraction}{0.85}\renewcommand{\bottomfraction}{0.6}\renewcommand{\textfraction}{0.12}\renewcommand{\floatpagefraction}{0.75}
\setlist{itemsep=1pt}

\RequirePackage[hidelinks]{hyperref}
\endinput
